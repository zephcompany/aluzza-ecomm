{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aluzza-tryon",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  "vars": {
    "PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-2.5-flash-image",
    "ALLOWED_ORIGINS": ""
  },
  // limite de 8 provas por minuto por IP
  "ratelimits": [ { "name": "RL", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } } ]
}
