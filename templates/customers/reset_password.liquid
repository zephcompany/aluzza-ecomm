{% render 'auth-wrap-open' %}
    <h1>Nova senha</h1><p>Escolha uma nova senha para {{ email }}.</p>
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}<div class="small" style="color:var(--erro)">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="rp-pass">Senha</label><input id="rp-pass" name="customer[password]" type="password" required minlength="6"></div>
      <div class="field"><label for="rp-pass2">Confirmar senha</label><input id="rp-pass2" name="customer[password_confirmation]" type="password" required minlength="6"></div>
      <button class="btn btn--block btn--lg" type="submit">Salvar nova senha</button>
    {%- endform -%}
{% render 'auth-wrap-close' %}
