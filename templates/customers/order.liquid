<section class="container">
  <div class="page-title"><h1>Pedido {{ order.name }}</h1><p>Feito em {{ order.created_at | date: '%d/%m/%Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p></div>
  <div class="cart-layout">
    <div class="cart-table">
      {%- for li in order.line_items -%}
      <div class="cart-item"><a class="cart-item__img" href="{{ li.url }}">{% if li.image %}<img src="{{ li.image | image_url: width: 220, height: 293, crop: 'center' }}" alt="">{% endif %}</a><div><div class="cart-item__name">{{ li.title }}</div><div class="cart-item__meta">{{ li.variant.title }} · Qtd. {{ li.quantity }}</div><div class="cart-item__row"><span></span><div class="price">{{ li.final_line_price | money }}</div></div></div></div>
      {%- endfor -%}
    </div>
    <aside class="cart-side">
      <h3>Resumo</h3>
      <div class="summary-row"><span>Subtotal</span><span class="price">{{ order.line_items_subtotal_price | money }}</span></div>
      {%- for d in order.discount_applications -%}<div class="summary-row" style="color:var(--ok)"><span>{{ d.title }}</span><span>− {{ d.total_allocated_amount | money }}</span></div>{%- endfor -%}
      <div class="summary-row"><span>Frete</span><span>{{ order.shipping_price | money }}</span></div>
      <div class="summary-row summary-row--total"><span>Total</span><span class="price">{{ order.total_price | money }}</span></div>
      {%- if order.shipping_address -%}<h4 class="mt-24" style="font-size:14px">Entrega</h4><p class="small muted">{{ order.shipping_address | format_address }}</p>{%- endif -%}
      <a class="btn btn--ghost btn--block mt-24" href="{{ routes.account_url }}">Voltar aos pedidos</a>
    </aside>
  </div>
</section>
