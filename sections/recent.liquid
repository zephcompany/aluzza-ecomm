<section class="section section--tight" id="recent-wrap" hidden><div class="container">
  <div class="section-head"><div><h2>{{ section.settings.title }}</h2></div><div class="rail__nav"><button class="rail__btn" data-prev aria-label="Anterior">{% render 'icon', name: 'arrL' %}</button><button class="rail__btn" data-next aria-label="Próximo">{% render 'icon', name: 'arrR' %}</button></div></div>
  <div class="rail"><div class="rail__track" id="recent" data-recent></div></div>
</div></section>

{% schema %}
{
  "name": "Vistos recentemente",
  "tag": "div",
  "settings": [ { "type": "text", "id": "title", "label": "Título", "default": "Você viu por último" } ],
  "presets": [ { "name": "Vistos recentemente" } ]
}
{% endschema %}
