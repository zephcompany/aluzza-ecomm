{%- comment -%} Uso: {% render 'coll-url', handle: 'saltos', tag: 'saltos' %} → URL da coleção, ou filtro por tag em /collections/all quando a coleção não existe {%- endcomment -%}
{%- assign c = collections[handle] -%}
{%- if c != blank and c.handle == handle -%}{{ c.url }}{%- else -%}{{ routes.all_products_collection_url }}/{{ tag | default: handle }}{%- endif -%}
